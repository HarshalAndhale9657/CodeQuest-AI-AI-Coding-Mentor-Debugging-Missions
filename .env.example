# Copy to .env and fill in. Never commit .env.

# Sandbox backend: "docker" for any deployment, "local" only for development (not sandboxed).
CQ_RUNNER=auto
CQ_DOCKER_IMAGE=codequest-judge:latest
# Optional: gVisor runtime if installed on the host
CQ_DOCKER_RUNTIME=

# SQLite database file for the API
CQ_DB_PATH=codequest.db

# Exact origins allowed to call the API (comma-separated), e.g. the Vercel app URL
CQ_ALLOWED_ORIGINS=http://localhost:3000

# Optional LLM wording layer (backend only, never in the frontend or extension)
OPENAI_API_KEY=
GEMINI_API_KEY=
