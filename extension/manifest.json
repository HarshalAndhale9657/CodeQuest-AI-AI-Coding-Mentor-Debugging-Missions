{
  "manifest_version": 3,
  "name": "CodeQuest Companion for LeetCode",
  "short_name": "CodeQuest",
  "version": "0.2.0",
  "description": "Your CodeQuest mentor on LeetCode: approach checks, concept hints and mistake detection. Never the answer.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open CodeQuest Companion",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "exclude_matches": ["https://leetcode.com/contest/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "exclude_matches": ["https://leetcode.com/contest/*"],
      "js": ["content/relay.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
